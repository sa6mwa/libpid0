{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PID0_BUILD_EXAMPLES": "ON",
        "PID0_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (prefer musl)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-prefer-musl.cmake"
      }
    },
    {
      "name": "release",
      "displayName": "Release (prefer musl)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-prefer-musl.cmake"
      }
    },
    {
      "name": "asan",
      "displayName": "Address/UB sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PID0_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "static-release",
      "displayName": "Release (prefer musl, static executables)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "x86_64-linux-gnu",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "musl-gcc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "x86_64-linux-musl",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "aarch64-linux-gnu",
        "PID0_TARGET_ARCH": "aarch64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "aarch64-linux-musl-gcc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "aarch64-linux-musl",
        "PID0_TARGET_ARCH": "aarch64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "arm-linux-gnueabihf-gcc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "armhf",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "armhf-linux-gnu",
        "PID0_TARGET_ARCH": "armhf",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "arm-linux-musleabihf-gcc",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "armhf",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "armhf-linux-musl",
        "PID0_TARGET_ARCH": "armhf",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "static-release", "configurePreset": "static-release" },
    { "name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release" },
    { "name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release" },
    { "name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release" },
    { "name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release" },
    { "name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release" },
    { "name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release" }
  ],
  "packagePresets": [
    {
      "name": "x86_64-linux-gnu-release",
      "configurePreset": "x86_64-linux-gnu-release",
      "generators": ["TGZ"]
    },
    {
      "name": "x86_64-linux-musl-release",
      "configurePreset": "x86_64-linux-musl-release",
      "generators": ["TGZ"]
    },
    {
      "name": "aarch64-linux-gnu-release",
      "configurePreset": "aarch64-linux-gnu-release",
      "generators": ["TGZ"]
    },
    {
      "name": "aarch64-linux-musl-release",
      "configurePreset": "aarch64-linux-musl-release",
      "generators": ["TGZ"]
    },
    {
      "name": "armhf-linux-gnu-release",
      "configurePreset": "armhf-linux-gnu-release",
      "generators": ["TGZ"]
    },
    {
      "name": "armhf-linux-musl-release",
      "configurePreset": "armhf-linux-musl-release",
      "generators": ["TGZ"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "static-release",
      "configurePreset": "static-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
