{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PID0_BUILD_EXAMPLES": "ON",
        "PID0_BUILD_TESTS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/cpkt-linux.cmake"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (pinned x86_64 Linux GNU)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PID0_TARGET_ID": "x86_64-linux-gnu",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "valgrind",
      "displayName": "Native Valgrind (pinned x86_64 Linux GNU)",
      "inherits": "debug"
    },
    {
      "name": "release",
      "displayName": "Release (pinned x86_64 Linux GNU)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_TARGET_ID": "x86_64-linux-gnu",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "asan",
      "displayName": "Address/UB sanitizer (pinned x86_64 Linux GNU)",
      "inherits": "debug",
      "cacheVariables": { "PID0_ENABLE_ASAN": "ON" }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "cacheVariables": { "PID0_BUILD_FUZZERS": "ON", "PID0_BUILD_EXAMPLES": "OFF", "PID0_BUILD_TESTS": "OFF", "PID0_TARGET_ID": "x86_64-linux-gnu" , "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/cpkt-aflpp.cmake" }
    },
    {
      "name": "static-release",
      "displayName": "Static release (pinned x86_64 Linux musl)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-static",
        "PID0_TARGET_ID": "x86_64-linux-musl",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "x86_64-linux-gnu",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "x86_64-linux-musl",
        "PID0_TARGET_ARCH": "x86_64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "aarch64-linux-gnu",
        "PID0_TARGET_ARCH": "aarch64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "aarch64-linux-musl",
        "PID0_TARGET_ARCH": "aarch64",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "armhf-linux-gnu",
        "PID0_TARGET_ARCH": "armhf",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "gnu"
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PID0_BUILD_EXAMPLES": "OFF",
        "PID0_BUILD_TESTS": "OFF",
        "PID0_TARGET_ID": "armhf-linux-musl",
        "PID0_TARGET_ARCH": "armhf",
        "PID0_TARGET_OS": "linux",
        "PID0_TARGET_LIBC": "musl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "valgrind", "configurePreset": "valgrind" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "static-release", "configurePreset": "static-release" },
    { "name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release" },
    { "name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release" },
    { "name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release" },
    { "name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release" },
    { "name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release" },
    { "name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "valgrind", "configurePreset": "valgrind", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
